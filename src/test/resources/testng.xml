<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Alberta Payments Automation Test Suite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="com.albertapayments.listeners.TestListener" />
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="com.albertapayments.tests.LoginTest" />
        </classes>
    </test>

    <test name="Dashboard and Shell Navigation Tests">
        <classes>
            <class name="com.albertapayments.tests.DashboardTest" />
        </classes>
    </test>

    <test name="Menu Management Tests">
        <classes>
            <class name="com.albertapayments.tests.MenuTest" />
        </classes>
    </test>

    <test name="End-to-End Regression Tests">
        <classes>
            <class name="com.albertapayments.tests.RegressionTest" />
        </classes>
    </test>

</suite>
